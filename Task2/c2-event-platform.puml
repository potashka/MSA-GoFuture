@startuml c2-event-platform
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров (C2) — событийная платформа GoFuture

Person(passenger, "Пассажир", "Пользователь мобильного приложения")
Person(driverUser, "Водитель", "Пользователь мобильного приложения водителя")

System_Boundary(platform, "GoFuture Event-Driven Platform") {

    Container(gateway, "API Gateway", "Kubernetes Ingress / Gateway", "Единая точка входа для клиентов")

    Container(booking, "Booking Service", "Domain Service", "Приём заказа; Booking Saga Orchestrator хранит состояние Saga и публикует команды в Kafka")
    Container(driverSvc, "Driver Service", "Domain Service", "Локация, доступность, резервирование и умный подбор водителей")
    Container(pricing, "Pricing Service", "Domain Service", "Динамическое ценообразование, price lock, surge")
    Container(payments, "Payments Service", "Domain Service", "Авторизация, release/void и списание платежей")
    Container(payouts, "Payouts Service", "Domain Service", "Выплаты водителям")
    Container(notification, "Notification Service", "Domain Service", "Доставка push/иных уведомлений")
    Container(geography, "Geography Service", "Domain Service", "Геопоиск и зоны спроса")
    Container(fraud, "Fraud Service", "Domain Service", "Обнаружение мошенничества")
    Container(analytics, "Analytics Service", "Domain Service", "Аналитика в реальном времени")

    Container(kafka, "Kafka Cluster (per region)", "Apache Kafka", "Событийная шина и command topics. Ключевые топики: {region}.booking.created/confirmed/cancelled, saga commands/results, {region}.driver.location.updated (compacted by driver key), pricing, payments, payouts, fraud, ride, notification")
    Container(dlq, "Dead Letter Topics", "Kafka DLQ topics", "{topic}.dlq на каждый топик/consumer group для сообщений, не обработанных после ретраев")
    Container(schemaRegistry, "Schema Registry", "Avro", "Реестр схем для producer/consumer serializers; BACKWARD-совместимость проверяется при регистрации схем")
    Container(flink, "Flink Cluster", "Apache Flink", "Оконные агрегации спроса/предложения по geo_cell: расчёт surge и умное перераспределение водителей")

    Boundary(observability, "Observability") {
        Container(otelCollector, "OpenTelemetry Collector", "OTel Collector", "Приём и маршрутизация OTLP метрик/логов/трейсов")
        Container(kafkaExporter, "Kafka Exporter", "Prometheus exporter", "Метрики Kafka brokers, partitions, ISR, latency и consumer lag")
        Container(flinkExporter, "Flink metrics/exporter", "Prometheus exporter", "Метрики Flink checkpoints, backpressure, watermarks и state")
        Container(prometheus, "Prometheus", "Monitoring", "Сбор и хранение технических, бизнес и SLI/SLO метрик")
        Container(loki, "Loki", "Logs", "Хранение структурированных логов с correlation attributes")
        Container(alertmanager, "Alertmanager", "Alerting", "Дедупликация, группировка и маршрутизация алертов")
        Container(grafana, "Grafana", "Dashboards", "Единый UI для метрик, логов, алертов и трейсов")
        Container(tempo, "Tempo", "Distributed tracing", "Хранение распределённых трейсов Saga и Kafka processing")
    }
}

Rel(passenger, gateway, "HTTPS/REST")
Rel(driverUser, gateway, "HTTPS/REST")

Rel(gateway, booking, "CreateBooking, GetBookingStatus, CancelBooking", "gRPC/HTTP, mTLS")

Rel(booking, kafka, "Публикует BookingCreated, Saga commands, BookingConfirmed, BookingCancellationRequested, BookingCancelled, RideStarted, RideCompleted, NotificationRequested", "Kafka")
Rel(kafka, fraud, "Команды: FraudCheckRequested", "Kafka")
Rel(fraud, kafka, "События результата: FraudCheckCompleted", "Kafka")
Rel(kafka, pricing, "Команды: PriceLockRequested", "Kafka")
Rel(pricing, kafka, "События результата: PriceLocked, PriceLockFailed; факты: PriceCalculated, SurgeActivated, NotificationRequested", "Kafka")
Rel(kafka, driverSvc, "Команды: DriverReservationRequested, DriverReleaseRequested; подписка: RideCompleted", "Kafka")
Rel(driverSvc, kafka, "События результата: DriverReserved, DriverReservationFailed, DriverReleased; факты: DriverAssigned, DriverLocationUpdated, NotificationRequested", "Kafka")
Rel(kafka, payments, "Команды: PaymentAuthorizationRequested, PaymentReleaseRequested; подписка: RideCompleted", "Kafka")
Rel(payments, kafka, "События результата: PaymentAuthorized, PaymentAuthorizationFailed, PaymentReleased; факты: PaymentCaptured, PaymentFailed, NotificationRequested", "Kafka")
Rel(kafka, booking, "Результаты Saga: FraudCheckCompleted, PriceLocked/Failed, DriverReserved/Failed, PaymentAuthorized/Failed, release results", "Kafka")

Rel(payouts, kafka, "Публикует PayoutInitiated, PayoutCompleted, NotificationRequested")
Rel(kafka, payouts, "Подписка: PaymentCaptured")
Rel(kafka, notification, "Подписка: NotificationRequested")
Rel(kafka, analytics, "Подписка: публичные доменные события")
Rel(kafka, geography, "Подписка: DriverLocationUpdated, BookingConfirmed")

Rel(kafka, flink, "Читает DriverLocationUpdated, BookingCreated; после dedup/sequence guard выполняет keyBy(event.payload.geo_cell)")
Rel(flink, kafka, "Публикует SurgeActivated")
Rel(kafka, dlq, "Маршрутизация необработанных сообщений после исчерпания ретраев")

Rel(booking, schemaRegistry, "Producer/consumer serializers получают и регистрируют схемы", "HTTPS")
Rel(driverSvc, schemaRegistry, "Producer/consumer serializers получают и регистрируют схемы", "HTTPS")
Rel(pricing, schemaRegistry, "Producer/consumer serializers получают и регистрируют схемы", "HTTPS")
Rel(payments, schemaRegistry, "Producer/consumer serializers получают и регистрируют схемы", "HTTPS")
Rel(payouts, schemaRegistry, "Producer/consumer serializers получают и регистрируют схемы", "HTTPS")
Rel(notification, schemaRegistry, "Consumer serializer получает схему NotificationRequested", "HTTPS")
Rel(geography, schemaRegistry, "Consumer serializer получает схемы DriverLocationUpdated/BookingConfirmed", "HTTPS")
Rel(fraud, schemaRegistry, "Producer/consumer serializers получают и регистрируют схемы", "HTTPS")
Rel(analytics, schemaRegistry, "Consumer serializers получают схемы доменных событий", "HTTPS")
Rel(flink, schemaRegistry, "Flink serializers/deserializers получают схемы потоков", "HTTPS")

Rel(booking, otelCollector, "Метрики/логи/трейсы с trace_id, saga_id, booking_id, region_id, tenant_id", "OTLP")
Rel(driverSvc, otelCollector, "Метрики/логи/трейсы", "OTLP")
Rel(pricing, otelCollector, "Метрики/логи/трейсы", "OTLP")
Rel(payments, otelCollector, "Метрики/логи/трейсы", "OTLP")
Rel(payouts, otelCollector, "Метрики/логи/трейсы", "OTLP")
Rel(notification, otelCollector, "Метрики/логи/трейсы", "OTLP")
Rel(geography, otelCollector, "Метрики/логи/трейсы", "OTLP")
Rel(fraud, otelCollector, "Метрики/логи/трейсы", "OTLP")
Rel(analytics, otelCollector, "Метрики/логи/трейсы", "OTLP")
Rel(flink, otelCollector, "Job metrics и traces", "OTLP")

Rel(kafka, kafkaExporter, "Метрики брокеров, partitions, ISR, latency, consumer lag", "JMX")
Rel(flink, flinkExporter, "Метрики checkpoints, backpressure, watermarks, state", "REST/JMX")
Rel(kafkaExporter, prometheus, "Отдаёт Kafka метрики", "scrape")
Rel(flinkExporter, prometheus, "Отдаёт Flink метрики", "scrape")
Rel(otelCollector, prometheus, "Экспортирует service/outbox/Saga метрики", "remote_write")
Rel(otelCollector, tempo, "Экспортирует трейсы", "OTLP")
Rel(otelCollector, loki, "Экспортирует структурированные логи/корреляцию", "push")
Rel(prometheus, alertmanager, "Отправляет алерты", "Alertmanager API")
Rel(grafana, prometheus, "Запросы метрик", "PromQL")
Rel(grafana, loki, "Запросы логов", "LogQL")
Rel(grafana, tempo, "Запросы трейсов", "TraceQL")
Rel(grafana, alertmanager, "Просмотр статуса алертов", "HTTP")

@enduml
