@startuml c2-event-platform
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров (C2) — событийная платформа GoFuture

Person(passenger, "Пассажир", "Пользователь мобильного приложения")
Person(driverUser, "Водитель", "Пользователь мобильного приложения водителя")

System_Boundary(platform, "GoFuture Event-Driven Platform") {

    Container(gateway, "API Gateway", "Kubernetes Ingress / Gateway", "Единая точка входа для клиентов")

    Container(booking, "Booking Service", "Domain Service", "Приём заказа; оркестратор саги бронирования (fraud check -> pricing -> driver matching -> payment authorization)")
    Container(driverSvc, "Driver Service", "Domain Service", "Локация, доступность и умный подбор водителей")
    Container(pricing, "Pricing Service", "Domain Service", "Динамическое ценообразование, surge")
    Container(payments, "Payments Service", "Domain Service", "Авторизация и списание платежей")
    Container(payouts, "Payouts Service", "Domain Service", "Выплаты водителям")
    Container(notification, "Notification Service", "Domain Service", "Доставка push/иных уведомлений")
    Container(geography, "Geography Service", "Domain Service", "Геопоиск и зоны спроса")
    Container(fraud, "Fraud Service", "Domain Service", "Обнаружение мошенничества")
    Container(analytics, "Analytics Service", "Domain Service", "Аналитика в реальном времени")

    Container(kafka, "Kafka Cluster (per region)", "Apache Kafka", "Событийная шина. Ключевые топики: {region}.booking.created/confirmed/cancelled, {region}.driver.assigned, {region}.driver.location.updated (compacted), {region}.pricing.calculated, {region}.pricing.surge-activated, {region}.payments.authorized/captured/failed, {region}.payouts.initiated/completed, {region}.fraud.check-completed, {region}.ride.started/completed, {region}.notification.requested")

    Container(dlq, "Dead Letter Topics", "Kafka DLQ topics", "{topic}.dlq на каждый топик/consumer group для сообщений, не обработанных после ретраев")

    Container(schemaRegistry, "Schema Registry", "Avro", "Реестр схем событий, проверка BACKWARD-совместимости")

    Container(flink, "Flink Cluster", "Apache Flink", "Оконные агрегации спроса/предложения по geo-ячейкам: расчёт surge и умное перераспределение водителей")

    Container(otelCollector, "OpenTelemetry Collector", "OTel Collector", "Приём и маршрутизация метрик/трейсов от сервисов")
    Container(kafkaExporter, "Kafka Exporter", "Prometheus exporter", "Экспортирует метрики брокеров и consumer lag")
    Container(prometheus, "Prometheus", "Monitoring", "Сбор и хранение метрик (RED, consumer lag, DLQ, пропускная способность топиков)")
    Container(grafana, "Grafana", "Dashboards", "Единые дашборды метрик и трейсов")
    Container(tempo, "Tempo", "Distributed tracing", "Хранение распределённых трейсов саги")
}

Rel(passenger, gateway, "HTTPS/REST")
Rel(driverUser, gateway, "HTTPS/REST")

Rel(gateway, booking, "CreateBooking, GetBookingStatus, CancelBooking", "gRPC, mTLS")

Rel(booking, fraud, "FraudCheck (команда шага саги)", "gRPC, синхронно, mTLS")
Rel(booking, pricing, "CalculatePrice (команда шага саги)", "gRPC, синхронно, mTLS")
Rel(booking, driverSvc, "RequestMatch (команда шага саги)", "gRPC, синхронно, mTLS")
Rel(booking, payments, "AuthorizePayment (команда шага саги)", "gRPC, синхронно, mTLS")

Rel(booking, kafka, "Публикует BookingCreated, BookingConfirmed, BookingCancelled, RideStarted, RideCompleted, NotificationRequested")
Rel(driverSvc, kafka, "Публикует DriverAssigned, DriverLocationUpdated")
Rel(pricing, kafka, "Публикует PriceCalculated, SurgeActivated")
Rel(payments, kafka, "Публикует PaymentAuthorized, PaymentCaptured, PaymentFailed")
Rel(payouts, kafka, "Публикует PayoutInitiated, PayoutCompleted")
Rel(fraud, kafka, "Публикует FraudCheckCompleted")

Rel(kafka, booking, "Подписка: FraudCheckCompleted, PriceCalculated, DriverAssigned, PaymentAuthorized, PaymentFailed")
Rel(kafka, payments, "Подписка: RideCompleted")
Rel(kafka, payouts, "Подписка: PaymentCaptured")
Rel(kafka, notification, "Подписка: NotificationRequested")
Rel(kafka, analytics, "Подписка: весь поток доменных событий")
Rel(kafka, geography, "Подписка: DriverLocationUpdated, BookingConfirmed")

Rel(kafka, flink, "Читает DriverLocationUpdated, BookingCreated")
Rel(flink, kafka, "Публикует SurgeActivated")

Rel(kafka, dlq, "Маршрутизация необработанных сообщений после исчерпания ретраев")

Rel(booking, schemaRegistry, "Регистрация/проверка схем событий", "HTTPS")
Rel(payments, schemaRegistry, "Регистрация/проверка схем событий", "HTTPS")
Rel(driverSvc, schemaRegistry, "Регистрация/проверка схем событий", "HTTPS")
Rel(pricing, schemaRegistry, "Регистрация/проверка схем событий", "HTTPS")
Rel(kafka, schemaRegistry, "Валидация схем при продюсировании/потреблении", "HTTPS")

Rel(booking, otelCollector, "Отправляет метрики/трейсы", "OTLP")
Rel(driverSvc, otelCollector, "Отправляет метрики/трейсы", "OTLP")
Rel(pricing, otelCollector, "Отправляет метрики/трейсы", "OTLP")
Rel(payments, otelCollector, "Отправляет метрики/трейсы", "OTLP")
Rel(payouts, otelCollector, "Отправляет метрики/трейсы", "OTLP")
Rel(notification, otelCollector, "Отправляет метрики/трейсы", "OTLP")
Rel(geography, otelCollector, "Отправляет метрики/трейсы", "OTLP")
Rel(fraud, otelCollector, "Отправляет метрики/трейсы", "OTLP")
Rel(analytics, otelCollector, "Отправляет метрики/трейсы", "OTLP")
Rel(flink, otelCollector, "Отправляет метрики/трейсы", "OTLP")

Rel(kafka, kafkaExporter, "Метрики брокеров и consumer lag", "JMX")
Rel(kafkaExporter, prometheus, "Отдаёт метрики", "scrape")
Rel(otelCollector, prometheus, "Экспортирует метрики", "remote_write")
Rel(otelCollector, tempo, "Экспортирует трейсы", "OTLP")

Rel(grafana, prometheus, "Запросы метрик", "PromQL")
Rel(grafana, tempo, "Запросы трейсов", "TraceQL")

@enduml
