@startuml c2-to-be
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров (C2, To-Be) — GoFuture, переходная архитектура Strangler Fig

Person(passenger, "Пассажир", "Пользователь мобильного приложения")
Person(driverUser, "Водитель", "Пользователь мобильного приложения водителя")
Person(corpUser, "Корпоративный клиент", "Пользователь веб-портала")
Person(admin, "Администратор", "Пользователь админ-панели")

System_Ext(yandexPay, "Яндекс Пэй", "Платёжный провайдер")
System_Ext(yandexMaps, "Яндекс Карты", "Картографический сервис")
System_Ext(pushProviders, "FCM / APNs / Huawei Push Kit", "Push-уведомления")
System_Ext(bankApi, "API банков", "Банковские платежи и выплаты")

System_Boundary(gofuture, "GoFuture Platform") {

    Container(mobileApps, "Мобильные приложения", "iOS / Android / Huawei", "Приложения пассажира и водителя")
    Container(webPortal, "Веб-портал и админ-панель", "Web", "Корпоративный портал и админ-панель")

    Container(gateway, "API Gateway", "Kubernetes Ingress / Gateway", "Маршрутизация, версионирование API, feature flags, canary-переключение монолит/сервис")
    Container(identity, "Identity Service", "Keycloak", "Аутентификация, авторизация, IAM (mTLS/JWT)")

    Container(acl, "Anti-Corruption Layer", "Adapter Service", "Транслирует контракты монолита в контракты доменных сервисов и обратно")

    Container(monolith, "Монолит GoFuture (усыхающий)", "Django, Celery, RabbitMQ", "Домены, ещё не вынесенные из монолита; сокращается по мере миграции")
    ContainerDb(monolithDb, "Monolith DB", "PostgreSQL RDS", "Исходная база монолита, источник CDC")
    Container(cdc, "CDC Connector", "Debezium", "Захват изменений (WAL) из БД монолита и публикация в шину событий")

    Container(kafka, "Event Bus", "Apache Kafka", "Асинхронная шина доменных событий")

    Container(booking, "Booking Service", "Domain Service", "Приём и жизненный цикл заказа поездки")
    ContainerDb(bookingDb, "Booking DB", "PostgreSQL", "Заказы, статусы поездок")

    Container(driverSvc, "Driver Service", "Domain Service", "Локация, доступность и матчинг водителей")
    ContainerDb(driverDb, "Driver DB", "PostgreSQL + Redis", "Профили, локация, доступность водителей")

    Container(pricing, "Pricing Service", "Domain Service", "Динамическое ценообразование")
    ContainerDb(pricingDb, "Pricing DB", "PostgreSQL", "Тарифы, surge-коэффициенты, история котировок")

    Container(payments, "Payments Service", "Domain Service", "Авторизация и списание платежей")
    ContainerDb(paymentsDb, "Payments DB", "PostgreSQL", "Транзакции, статусы платежей")

    Container(payouts, "Payouts Service", "Domain Service", "Выплаты водителям")
    ContainerDb(payoutsDb, "Payouts DB", "PostgreSQL", "Реестр заработка и выплаты водителей")

    Container(notification, "Notification Service", "Domain Service", "Push и другие уведомления")
    ContainerDb(notificationDb, "Notification DB", "PostgreSQL", "Шаблоны, статусы доставки")

    Container(geography, "Geography Service", "Domain Service", "Геопоиск и зоны спроса")
    ContainerDb(geographyDb, "Geography DB", "Elasticsearch", "Геообъекты, зоны, карта спроса")

    Container(fraud, "Fraud Service", "Domain Service", "Обнаружение мошенничества")
    ContainerDb(fraudDb, "Fraud DB", "PostgreSQL", "Риск-скоринг, чёрные списки")

    Container(analytics, "Analytics Service", "Domain Service", "Аналитика в реальном времени")
    ContainerDb(analyticsDb, "ClickHouse", "ClickHouse", "Витрины и агрегаты (Spark/Flink, DataLens)")
}

Rel(passenger, mobileApps, "Использует")
Rel(driverUser, mobileApps, "Использует")
Rel(corpUser, webPortal, "Использует")
Rel(admin, webPortal, "Использует")

Rel(mobileApps, gateway, "Запросы", "HTTPS/REST, gRPC")
Rel(webPortal, gateway, "Запросы", "HTTPS/REST")

Rel(gateway, identity, "Проверка токена", "mTLS, JWT")
Rel(gateway, monolith, "Маршрутизация legacy-запросов (доля трафика сокращается)", "HTTPS, mTLS")
Rel(gateway, acl, "Маршрутизация к перенесённым доменам", "HTTPS, mTLS")

Rel(acl, booking, "Вызов", "gRPC, mTLS")
Rel(acl, driverSvc, "Вызов", "gRPC, mTLS")
Rel(acl, pricing, "Вызов", "gRPC, mTLS")
Rel(acl, payments, "Вызов", "gRPC, mTLS")
Rel(acl, payouts, "Вызов", "gRPC, mTLS")
Rel(acl, geography, "Вызов", "gRPC, mTLS")
Rel(acl, monolith, "Трансляция вызовов к невынесенным доменам", "HTTPS, mTLS")

Rel(booking, bookingDb, "Читает/пишет", "SQL")
Rel(driverSvc, driverDb, "Читает/пишет", "SQL")
Rel(pricing, pricingDb, "Читает/пишет", "SQL")
Rel(payments, paymentsDb, "Читает/пишет", "SQL")
Rel(payouts, payoutsDb, "Читает/пишет", "SQL")
Rel(notification, notificationDb, "Читает/пишет", "SQL")
Rel(geography, geographyDb, "Читает/пишет", "REST")
Rel(fraud, fraudDb, "Читает/пишет", "SQL")
Rel(analytics, analyticsDb, "Читает/пишет", "SQL")

Rel(booking, pricing, "Запрос котировки", "gRPC, синхронно")
Rel(booking, driverSvc, "Запрос матчинга водителя", "gRPC, синхронно")

Rel(booking, kafka, "Публикует BookingCreated, BookingConfirmed, TripCompleted")
Rel(driverSvc, kafka, "Публикует DriverLocationUpdated, DriverMatched")
Rel(pricing, kafka, "Публикует PriceQuoted, SurgeZoneUpdated")
Rel(payments, kafka, "Публикует PaymentAuthorized, PaymentCaptured, PaymentFailed")
Rel(payouts, kafka, "Публикует PayoutInitiated, PayoutCompleted")
Rel(geography, kafka, "Публикует HotZoneDetected, ZoneDemandUpdated")

Rel(kafka, notification, "Подписка на доменные события")
Rel(kafka, fraud, "Подписка на доменные события")
Rel(kafka, analytics, "Подписка на доменные события")
Rel(kafka, payouts, "Подписка на TripCompleted, PaymentCaptured")
Rel(kafka, pricing, "Подписка на события Geography/Driver")
Rel(kafka, driverSvc, "Подписка на HotZoneDetected/ZoneDemandUpdated")

Rel(payments, yandexPay, "Платежи", "HTTPS")
Rel(payments, bankApi, "Платежи", "HTTPS")
Rel(payouts, bankApi, "Выплаты", "HTTPS")
Rel(geography, yandexMaps, "Карты и маршруты", "HTTPS")
Rel(notification, pushProviders, "Push-уведомления", "HTTPS")

Rel(monolithDb, cdc, "Логическая репликация", "WAL")
Rel(cdc, kafka, "Публикует изменения как события")
Rel(kafka, booking, "CDC-события монолита для dual-write/сверки (переходный период)")
Rel(kafka, payments, "CDC-события монолита для dual-write/сверки (переходный период)")

@enduml
