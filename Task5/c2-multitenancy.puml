@startuml c2-multitenancy
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров (C2) — мультитенантная платформа GoFuture: IAM, изоляция, мониторинг

Person(tenantAdmin, "Администратор партнёра", "Сотрудник тенанта")
Person(driverUser, "Водитель", "Пользователь тенанта")
Person(passenger, "Пассажир", "Пользователь тенанта")
Person(platformSupport, "Оператор поддержки платформы", "Персонал GoFuture")

System_Ext(partnerIdp, "Корпоративный IdP партнёра", "OIDC/SAML")

System_Boundary(platform, "GoFuture Multi-Tenant Platform") {

    Container(gateway, "API Gateway", "Kubernetes Ingress / Gateway", "Маршрутизация; квоты и rate limiting на тенанта")

    Container(keycloak, "Keycloak", "IAM", "Platform realm + realm на каждого тенанта; SSO через OIDC/SAML")

    Container(pricingSvc, "Pricing Service", "Domain Service", "Тенант-специфичные тарифы")
    Container(bookingSvc, "Booking Service", "Domain Service", "Оркестратор саги; tenant_id в каждом событии")
    Container(otherServices, "Остальные доменные сервисы", "Driver, Payments, Payouts, Notification, Geography, Fraud", "Общий пул сервисов региона")

    ContainerDb(sharedDb, "Сервисные БД (pool)", "PostgreSQL + RLS по tenant_id", "Общие таблицы для pool-тенантов")
    ContainerDb(siloDb, "Сервисные БД/схемы (silo)", "PostgreSQL, выделенная схема/БД", "Структурно изолированные данные крупных тенантов")

    Container(kafka, "Kafka (per region)", "Apache Kafka", "tenant_id в конверте каждого события; выделенные партиции/топики по тенанту")

    Container(otelCollector, "OpenTelemetry Collector", "OTel Collector", "Метрики/трейсы с меткой tenant_id")
    Container(prometheus, "Prometheus", "Monitoring", "Метрики с меткой tenant_id; алерты по квотам/лимитам")
    Container(grafana, "Grafana", "Dashboards", "Дашборды, параметризованные tenant_id")
    Container(alertmanager, "Alertmanager", "Alerting", "Алерты по превышению квот, аномалиям тенанта")
}

Rel(tenantAdmin, partnerIdp, "Аутентификация в корпоративном IdP")
Rel(partnerIdp, keycloak, "Федерация identity provider (realm тенанта)", "OIDC/SAML")

Rel(driverUser, gateway, "Запросы", "HTTPS")
Rel(passenger, gateway, "Запросы", "HTTPS")
Rel(tenantAdmin, gateway, "Запросы администрирования", "HTTPS")
Rel(platformSupport, gateway, "Диагностика (все тенанты, ограниченно)", "HTTPS")

Rel(gateway, keycloak, "Проверка токена (tenant_id, home_region, роль)", "mTLS, JWT")
Rel(gateway, bookingSvc, "Маршрутизация с учётом квот/rate limit тенанта", "gRPC, mTLS")
Rel(gateway, pricingSvc, "Маршрутизация с учётом квот/rate limit тенанта", "gRPC, mTLS")
Rel(gateway, otherServices, "Маршрутизация с учётом квот/rate limit тенанта", "gRPC, mTLS")

Rel(bookingSvc, sharedDb, "Читает/пишет (pool, RLS по tenant_id)", "SQL")
Rel(pricingSvc, sharedDb, "Читает/пишет (pool, RLS по tenant_id)", "SQL")
Rel(otherServices, sharedDb, "Читает/пишет (pool, RLS по tenant_id)", "SQL")

Rel(bookingSvc, siloDb, "Читает/пишет (silo-тенанты)", "SQL")
Rel(pricingSvc, siloDb, "Читает/пишет (silo-тенанты)", "SQL")

Rel(bookingSvc, kafka, "Публикует события с tenant_id")
Rel(pricingSvc, kafka, "Публикует события с tenant_id")
Rel(otherServices, kafka, "Публикует/потребляет события с tenant_id")

Rel(gateway, otelCollector, "Отправляет метрики/трейсы (с меткой tenant_id)", "OTLP")
Rel(bookingSvc, otelCollector, "Отправляет метрики/трейсы (с меткой tenant_id)", "OTLP")
Rel(pricingSvc, otelCollector, "Отправляет метрики/трейсы (с меткой tenant_id)", "OTLP")
Rel(otherServices, otelCollector, "Отправляет метрики/трейсы (с меткой tenant_id)", "OTLP")

Rel(otelCollector, prometheus, "Экспортирует метрики", "remote_write")
Rel(prometheus, alertmanager, "Алерты по превышению квот/аномалиям tenant_id")
Rel(grafana, prometheus, "Запросы метрик (фильтр по tenant_id)", "PromQL")

note right of gateway
  Квоты и rate limiting настраиваются
  на тенанта при онбординге
  (см. 03-onboarding.md) и применяются
  до попадания запроса в доменные сервисы.
end note

note right of sharedDb
  RLS-политика: USING (tenant_id =
  current_setting('app.tenant_id'))
  на каждой тенант-специфичной таблице.
end note

@enduml
