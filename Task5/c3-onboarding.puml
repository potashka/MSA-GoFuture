@startuml c3-onboarding
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Диаграмма компонентов (C3) — процесс онбординга партнёра

Person(partner, "Партнёр / бизнес-девелопмент", "Подаёт заявку на онбординг")

Container_Boundary(onboarding, "Onboarding Service") {
    Component(selfServiceApi, "Self-Service API", "REST API", "Приём заявки, создание объекта Tenant (CRD), статус онбординга")
    Component(orchestrator, "Onboarding Orchestrator", "Оркестратор шагов", "Хранит прогресс заявки, инициирует следующий шаг, обрабатывает отказ (см. 03-onboarding.md)")
    Component(terraformRunner, "Terraform Runner", "IaC executor", "Одноразовое провижининг: realm, топики, квоты, дашборды")
    Component(tenantOperator, "Tenant Operator", "Kubernetes controller", "Постоянное согласование состояния тенанта (reconciliation), апгрейд уровня изоляции, оффбординг")
    Component(smokeTestRunner, "Smoke Test Runner", "Test pipeline", "Сквозные проверки перед активацией")
}

Container(keycloak, "Keycloak", "IAM", "Realm/клиенты/федерация IdP тенанта")
ContainerDb(serviceDbs, "Сервисные БД", "PostgreSQL", "tenant_id / RLS-политики (pool) либо выделенная схема (silo)")
Container(kafka, "Kafka (per region)", "Apache Kafka", "Партиции/топики тенанта")
Container(gateway, "API Gateway", "Gateway", "Квоты и rate limiting тенанта")
Container(grafana, "Grafana", "Dashboards", "Дашборды тенанта")
Container(secretsManager, "Secrets Manager", "Managed secret store", "Ключи локальных платёжных/картографических провайдеров")
System_Ext(paymentProvider, "Локальный платёжный провайдер", "Внешняя интеграция")
System_Ext(mapsProvider, "Локальный картографический провайдер", "Внешняя интеграция")

Rel(partner, selfServiceApi, "Подаёт заявку (регион, масштаб, уровень изоляции, IdP)", "HTTPS")
Rel(selfServiceApi, orchestrator, "Создаёт Tenant (CRD), статус pending")

Rel(orchestrator, terraformRunner, "Инициирует провижининг")
Rel(orchestrator, tenantOperator, "Передаёт объект Tenant на согласование")
Rel(orchestrator, smokeTestRunner, "Запускает проверки после провижининга")

Rel(terraformRunner, keycloak, "Создаёт realm, клиентов, федерацию IdP")
Rel(terraformRunner, serviceDbs, "Создаёт схему/регистрирует tenant_id, проверяет RLS")
Rel(terraformRunner, kafka, "Создаёт/резервирует топики и партиции")
Rel(terraformRunner, gateway, "Настраивает квоты и rate limiting")
Rel(terraformRunner, grafana, "Провижининг дашбордов (шаблон с переменной tenant_id)")

Rel(tenantOperator, keycloak, "Reconciliation realm/клиентов")
Rel(tenantOperator, serviceDbs, "Reconciliation схемы/RLS при апгрейде уровня изоляции")
Rel(tenantOperator, kafka, "Reconciliation топиков/партиций")
Rel(tenantOperator, gateway, "Reconciliation квот")

Rel(orchestrator, secretsManager, "Запрашивает ключи локальных провайдеров")
Rel(secretsManager, paymentProvider, "Ключи для конфигурации Payments Service тенанта")
Rel(secretsManager, mapsProvider, "Ключи для конфигурации Geography Service тенанта")

Rel(smokeTestRunner, keycloak, "Проверка входа/SSO")
Rel(smokeTestRunner, serviceDbs, "Проверка изоляции: попытка кросс-тенантного чтения должна быть отклонена")
Rel(smokeTestRunner, kafka, "Проверка tenant_id в событиях и партиционирования")
Rel(smokeTestRunner, gateway, "Проверка квот/rate limiting")
Rel(smokeTestRunner, grafana, "Проверка отображения данных на дашборде")

Rel(smokeTestRunner, orchestrator, "Результат проверок (pass/fail)")
Rel(orchestrator, selfServiceApi, "Обновляет статус: active / failed")
Rel(selfServiceApi, partner, "Уведомление об активации/отказе")

@enduml
